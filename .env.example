# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Usada diretamente ao rodar a API fora do Docker (ex.: sqlite:///./pokemon.db).
# Em docker-compose, a URL do Postgres é montada automaticamente a partir das
# variáveis POSTGRES_* abaixo e não precisa ser definida aqui.
DATABASE_URL=sqlite:///./pokemon.db

# Credenciais de HTTP Basic Auth exigidas pelos endpoints da API.
API_USERNAME=kauan
API_PASSWORD=admin

# Usadas apenas pelo container do Postgres no docker-compose.
POSTGRES_USER=pokedox
POSTGRES_PASSWORD=pokedox
POSTGRES_DB=pokedox
